# Copy this file to .env.local and fill in the values

# MongoDB Atlas connection string (SRV). Do not append a db name; app uses dbName "tasks".
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=<AppName>

# NextAuth
NEXTAUTH_SECRET=replace-with-strong-random-string
# For production on Vercel, set to your prod URL; omit for previews or rely on AUTH_TRUST_HOST.
NEXTAUTH_URL=https://your-app.vercel.app
AUTH_TRUST_HOST=true

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
